# Application
APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL
DATABASE_URL="postgresql://halloween:halloween@localhost:5432/halloween_tangier"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Seeded staff accounts (used only by prisma/seed.ts)
ADMIN_EMAIL="admin@halloween-tangier.local"
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_NAME="Event Admin"
STAFF_EMAIL="staff@halloween-tangier.local"
STAFF_PASSWORD="change-this-staff-password"
STAFF_NAME="Door Staff"

# Cron / reservation expiry — send as Authorization: Bearer <secret>
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional SMTP. If unset, emails are written to var/emails/ (development sandbox).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Halloween Tangier <tickets@localhost>"

# Optional CMI / PayZone. Leave empty until merchant credentials are issued.
# Online payments stay disabled without these values. Redirects never mark orders paid.
CMI_ENABLED="false"
CMI_CLIENT_ID=""
CMI_STORE_KEY=""
CMI_GATEWAY_URL=""
CMI_STORE_TYPE="3D_PAY_HOSTING"
CMI_HASH_ALGORITHM="SHA512"
CMI_CURRENCY="504"

# Optional analytics — loaded only after visitor consent
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
